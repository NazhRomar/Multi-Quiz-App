{
  "manifest_version": 3,
  "name": "Quiz Harvester",
  "version": "0.1.0",
  "description": "Passively captures quiz questions/answers from the current page for later import into Multi Quiz App. Never clicks anything on the page.",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation", "tabs"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
